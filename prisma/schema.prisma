generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  autor     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

enum Role {
  PROFESSOR
  ALUNO
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(ALUNO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
